# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────
# 32-byte hex key used to encrypt each user's Outscraper API key at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=your_64_char_hex_secret_here

# Secret used to sign session cookies. Any long random string.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your_long_random_session_secret_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (defaults to 3056)
PORT=3056

# Set to "production" on the live server so session cookies are marked Secure.
NODE_ENV=production

# Where the SQLite DB lives (defaults to ./data/gmb.db)
# DB_PATH=/opt/gmb-scraper/data/gmb.db

# NOTE: There is no global OUTSCRAPER_API_KEY anymore. Each user adds their own
# key after logging in, and it is stored encrypted in the database.
